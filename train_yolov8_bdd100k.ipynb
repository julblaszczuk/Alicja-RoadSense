# ============================================================
# KROK 3: Weryfikacja formatu YOLO (dataset już skonwertowany)
# ============================================================
# Kaggle i Roboflow dostarczają dataset w formacie YOLO.
# Sprawdzamy czy labels istnieją i mają poprawny format.

print("Weryfikacja formatu YOLO...")

# Sprawdź przykładowy label
sample_labels_dir = '/content/bdd100k/train/labels'
if os.path.exists(sample_labels_dir):
    label_files = [f for f in os.listdir(sample_labels_dir) if f.endswith('.txt')]
    if label_files:
        sample_label = os.path.join(sample_labels_dir, label_files[0])
        with open(sample_label) as f:
            lines = f.readlines()
        print(f"Przykładowy label ({label_files[0]}):")
        for line in lines[:5]:
            print(f"  {line.strip()}")
        print(f"  ... ({len(lines)} annotacji)")
        
        # Sprawdź czy format YOLO: class_id cx cy w h
        parts = lines[0].strip().split()
        if len(parts) == 5:
            print("✅ Format YOLO poprawny (class_id cx cy w h)")
        else:
            print(f"⚠️ Nieoczekiwany format: {len(parts)} kolumn")
    else:
        print("⚠️ Brak plików .txt w train/labels/")
else:
    print("⚠️ Katalog train/labels/ nie istnieje")

# Sprawdź czy labels pasują do images
train_labels_count = len([f for f in os.listdir('/content/bdd100k/train/labels') if f.endswith('.txt')]) if os.path.exists('/content/bdd100k/train/labels') else 0
val_labels_count = len([f for f in os.listdir('/content/bdd100k/val/labels') if f.endswith('.txt')]) if os.path.exists('/content/bdd100k/val/labels') else 0

print(f"\n📊 Podsumowanie:")
print(f"  Train: {train_imgs} images, {train_labels_count} labels")
print(f"  Val: {val_imgs} images, {val_labels_count} labels")

if train_labels_count == 0:
    print("\n⚠️ Brak labels! Dataset może wymagać konwersji.")
    print("Jeśli używasz surowego BDD100K JSON, uruchom konwersję ręcznie.")
else:
    print("✅ Dataset w formacie YOLO - gotowy do treningu!")

# ============================================================
# KROK 4: Przygotowanie data.yaml
# ============================================================

data_yaml = """
# BDD100K Dataset - Alicja RoadSense
# 10 klas: pojazdy, piesi, znaki

path: /content/bdd100k
train: train/images
val: val/images

nc: 10
names:
  0: person
  1: rider
  2: car
  3: truck
  4: bus
  5: train
  6: motorcycle
  7: bicycle
  8: traffic light
  9: traffic sign
"""

with open('/content/data.yaml', 'w') as f:
    f.write(data_yaml)

print("data.yaml utworzony")

# ============================================================
# KROK 5: Fine-tuning YOLOv8n
# ============================================================

# Pobierz pre-trained YOLOv8n
model = YOLO('yolov8n.pt')

# Trening (2h na T4 GPU)
results = model.train(
    data='/content/data.yaml',
    epochs=50,          # 50 epok wystarczy dla fine-tuningu
    imgsz=640,          # 640x640 input (szybki na mobile)
    batch=16,           # batch size dla T4 GPU
    device=0,           # GPU
    patience=10,        # early stopping
    save=True,          # zapisz checkpointy
    name='alicja_roadsense_bdd100k',
    
    # Augmentacje dla jazdy samochodem
    hsv_h=0.015,        # hue augmentation
    hsv_s=0.7,          # saturation
    hsv_v=0.4,          # value (brightness)
    degrees=0.0,        # rotation (mała dla jazdy)
    translate=0.1,      # translation
    scale=0.5,          # scaling
    shear=0.0,          # shear
    perspective=0.0,    # perspective
    flipud=0.0,         # no vertical flip
    fliplr=0.5,         # horizontal flip
    mosaic=1.0,         # mosaic augmentation
    mixup=0.0,          # mixup
    copy_paste=0.0,     # copy-paste
)

print(f"Trening zakończony! Model: {results.path}")

# ============================================================
# KROK 6: Ewaluacja
# ============================================================

# Test na validation set
metrics = model.val()
print(f"mAP50: {metrics.box.map50:.4f}")
print(f"mAP50-95: {metrics.box.map:.4f}")

# Per-class metrics
print("\nPer-class mAP50:")
for i, name in enumerate(model.names.values()):
    print(f"  {name}: {metrics.box.ap50[i]:.4f}")

# ============================================================
# KROK 7: Export do TFLite (INT8 quantized)
# ============================================================

print("Eksport do TFLite...")

# Metoda 1: Bezpośredni export Ultralytics (najprostsza)
try:
    print("Metoda 1: Ultralytics direct export...")
    best_model = YOLO('/content/runs/detect/alicja_roadsense_bdd100k/weights/best.pt')
    best_model.export(format='tflite', int8=True, imgsz=640, data='/content/data.yaml')
    
    # Ultralytics zapisuje do: best_saved_model/best_full_integer_quant.tflite
    import glob
    tflite_files = glob.glob('/content/runs/detect/alicja_roadsense_bdd100k/weights/**/*.tflite', recursive=True)
    
    if tflite_files:
        output_path = tflite_files[0]
        print(f"✅ TFLite wyeksportowany: {output_path}")
    else:
        raise FileNotFoundError("Brak pliku .tflite")
        
except Exception as e:
    print(f"Metoda 1 nie zadziałała: {e}")
    print("\nMetoda 2: ONNX → TFLite (manualna)...")
    
    # Krok 1: YOLO → ONNX
    model.export(format='onnx', imgsz=640, dynamic=False, simplify=True)
    print("ONNX wyeksportowany")
    
    # Krok 2: ONNX → TensorFlow SavedModel
    import onnx
    from onnx_tf.backend import prepare
    
    onnx_model = onnx.load('/content/runs/detect/alicja_roadsense_bdd100k/weights/best.onnx')
    tf_rep = prepare(onnx_model)
    tf_rep.export_graph('/content/yolov8n_bdd100k_saved_model')
    print("SavedModel wyeksportowany")
    
    # Krok 3: SavedModel → TFLite INT8
    import tensorflow as tf
    
    converter = tf.lite.TFLiteConverter.from_saved_model('/content/yolov8n_bdd100k_saved_model')
    
    def representative_dataset():
        import cv2
        import numpy as np
        import glob
        img_paths = glob.glob('/content/bdd100k/val/images/*.jpg')[:100]
        for img_path in img_paths:
            img = cv2.imread(img_path)
            img = cv2.resize(img, (640, 640))
            img = img.astype(np.float32) / 255.0
            img = np.expand_dims(img, axis=0)
            yield [img]
    
    converter.optimizations = [tf.lite.Optimize.DEFAULT]
    converter.representative_dataset = representative_dataset
    converter.target_spec.supported_ops = [tf.lite.OpsSet.TFLITE_BUILTINS_INT8]
    converter.inference_input_type = tf.uint8
    converter.inference_output_type = tf.float32
    
    tflite_model = converter.convert()
    output_path = '/content/yolov8n_bdd100k_int8.tflite'
    with open(output_path, 'wb') as f:
        f.write(tflite_model)

print(f"\n✅ TFLite INT8: {output_path}")
print(f"Rozmiar: {os.path.getsize(output_path) / 1024 / 1024:.2f} MB")

# ============================================================
# KROK 8: Pobierz model na lokalny komputer
